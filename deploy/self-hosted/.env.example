# Copy to .env and fill in the required values.

# Release to run (a tag such as 0.1.0); latest by default.
MM_VERSION=latest

# Public URL users and agents reach this instance on (used in emails and install scripts).
PUBLIC_URL=http://localhost:8000
HTTP_PORT=8000

# Required. Generate with: openssl rand -base64 32
JWT_SECRET=
DB_PASSWORD=

# Encrypts stored check credentials (SQL, SNMP, SMTP). Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Required. The instance admin account, created already verified at startup.
# The password is reset to this value at every start while it is set here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Outgoing email for invitations, password resets and alert notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Signs unsubscribe links in notification emails. Generate with: openssl rand -hex 32
UNSUB_SECRET=

# Root-cause explanations. "rules" needs nothing; "single_shot" calls any
# OpenAI-compatible endpoint (OpenAI, Groq, Mistral, a local model...).
EXPLAIN_MODE=rules
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
