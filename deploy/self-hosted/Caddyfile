# Single entry point, same routing as the hosted service: ingestion paths go to
# the receiver, the rest of /api to the API, everything else to the UI.
:80 {
	encode zstd gzip

	@receiver path /v1/* /api/v1/agents/* /api/v1/errors /api/v1/metrics /api/v1/profiles /api/v1/frontend-errors /api/v1/health/*
	handle @receiver {
		reverse_proxy receiver:8081
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy frontend:80
	}
}
